<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{30E272EF-E0DF-4FAA-BCE8-65162B6E1269}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="CanhotoRapidoApp.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Service\ForegroundLocationService.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="CanhotoRapidoApp">
        <MSBuild Projects="CanhotoRapidoApp.dproj"/>
    </Target>
    <Target Name="CanhotoRapidoApp:Clean">
        <MSBuild Projects="CanhotoRapidoApp.dproj" Targets="Clean"/>
    </Target>
    <Target Name="CanhotoRapidoApp:Make">
        <MSBuild Projects="CanhotoRapidoApp.dproj" Targets="Make"/>
    </Target>
    <Target Name="ForegroundLocationService">
        <MSBuild Projects="Service\ForegroundLocationService.dproj"/>
    </Target>
    <Target Name="ForegroundLocationService:Clean">
        <MSBuild Projects="Service\ForegroundLocationService.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ForegroundLocationService:Make">
        <MSBuild Projects="Service\ForegroundLocationService.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="CanhotoRapidoApp;ForegroundLocationService"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="CanhotoRapidoApp:Clean;ForegroundLocationService:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="CanhotoRapidoApp:Make;ForegroundLocationService:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
